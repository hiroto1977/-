# MCP サーバー用 環境変数テンプレート
# このファイルをコピーして ~/.zshrc や ~/.bash_profile に追記する
# ※ このファイルには実際のキーを書かないこと

# ─────────────────────────────────────────
# GitHub  (https://github.com/settings/tokens/new)
# scopes: repo, read:org, read:user, gist
# 形式: ghp_<40文字の英数字>
# ─────────────────────────────────────────
export GITHUB_TOKEN="<REPLACE_WITH_GITHUB_TOKEN>"

# ─────────────────────────────────────────
# Atlassian / Jira / Confluence
# https://id.atlassian.com/manage-profile/security/api-tokens
# 形式: 24文字のトークン文字列
# ─────────────────────────────────────────
export ATLASSIAN_SITE_URL="https://yourcompany.atlassian.net"
export ATLASSIAN_EMAIL="you@example.com"
export ATLASSIAN_API_TOKEN="<REPLACE_WITH_ATLASSIAN_API_TOKEN>"

# ─────────────────────────────────────────
# Notion  (https://www.notion.so/my-integrations)
# 形式: secret_ から始まる文字列
# ─────────────────────────────────────────
export NOTION_API_KEY="<REPLACE_WITH_NOTION_API_KEY>"

# ─────────────────────────────────────────
# Slack  (https://api.slack.com/apps)
# Bot Token: xoxb- で始まるトークン
# Team ID: T で始まる英数字（Workspace URL から確認）
# Bot Token Scopes: channels:history, channels:read,
#   chat:write, files:read, groups:history, users:read
# ─────────────────────────────────────────
export SLACK_BOT_TOKEN="<REPLACE_WITH_SLACK_BOT_TOKEN>"
export SLACK_TEAM_ID="<REPLACE_WITH_SLACK_TEAM_ID>"

# ─────────────────────────────────────────
# Linear  (https://linear.app/settings/api)
# 形式: lin_api_ から始まるトークン
# ─────────────────────────────────────────
export LINEAR_API_KEY="<REPLACE_WITH_LINEAR_API_KEY>"

# ─────────────────────────────────────────
# Sentry  (https://sentry.io/settings/account/api/auth-tokens/)
# scopes: project:read, org:read, event:read
# 形式: sntrys_ から始まるトークン
# ─────────────────────────────────────────
export SENTRY_AUTH_TOKEN="<REPLACE_WITH_SENTRY_AUTH_TOKEN>"

# ─────────────────────────────────────────
# Stripe  (https://dashboard.stripe.com/apikeys)
# テスト環境: sk_test_ から始まる / 本番: sk_live_ から始まる
# 注意: 本番キーはサンドボックス以外では使用しないこと
# ─────────────────────────────────────────
export STRIPE_SECRET_KEY="<REPLACE_WITH_STRIPE_SECRET_KEY>"

# ─────────────────────────────────────────
# Cloudflare  (https://dash.cloudflare.com/profile/api-tokens)
# Template: Edit Cloudflare Workers + Read Zone Settings
# ─────────────────────────────────────────
export CLOUDFLARE_API_TOKEN="<REPLACE_WITH_CLOUDFLARE_API_TOKEN>"

# ─────────────────────────────────────────
# Discord  (https://discord.com/developers/applications)
# Bot → Token（Privileged Gateway Intents も有効化すること）
# ─────────────────────────────────────────
export DISCORD_BOT_TOKEN="<REPLACE_WITH_DISCORD_BOT_TOKEN>"

# ─────────────────────────────────────────
# YouTube Data API v3
# https://console.cloud.google.com/ → APIs → YouTube Data API v3 → Credentials
# 形式: AIza から始まる39文字
# ─────────────────────────────────────────
export YOUTUBE_API_KEY="<REPLACE_WITH_YOUTUBE_API_KEY>"

# ─────────────────────────────────────────
# Brave Search API  (https://api.search.brave.com/register)
# 無料: 2,000 req/月 / 有料: 無制限
# ─────────────────────────────────────────
export BRAVE_API_KEY="<REPLACE_WITH_BRAVE_API_KEY>"

# ─────────────────────────────────────────
# Google Maps Platform
# https://console.cloud.google.com/ → Maps JavaScript API → Credentials
# 形式: AIza から始まる39文字
# ─────────────────────────────────────────
export GOOGLE_MAPS_API_KEY="<REPLACE_WITH_GOOGLE_MAPS_API_KEY>"
