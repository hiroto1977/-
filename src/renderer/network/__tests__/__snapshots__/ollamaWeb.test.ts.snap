exports[`セットアップ手順の golden > desktopSetupCommands — 既定モデルと差し替え > desktop-default 1`] = `
[
  {
    "command": "# 1. Ollama を入れる (入っていれば何もしません)
command -v ollama >/dev/null || curl -fsSL https://ollama.com/install.sh | sh
# 2. 軽いモデルを 1 つ入れる (約 1.3 GB)
ollama pull llama3.2:1b",
    "os": "Linux",
  },
  {
    "command": "# 1. https://ollama.com/download から Ollama.app を入れて一度起動
# 2. 軽いモデルを 1 つ入れる (約 1.3 GB)
ollama pull llama3.2:1b",
    "os": "macOS",
  },
  {
    "command": "# 1. Ollama を入れる (入っていれば何もしません)
if (-not (Get-Command ollama -EA SilentlyContinue)) { winget install -e --id Ollama.Ollama }
# 2. 軽いモデルを 1 つ入れる (約 1.3 GB)
ollama pull llama3.2:1b",
    "os": "Windows (PowerShell)",
  },
]
`;

