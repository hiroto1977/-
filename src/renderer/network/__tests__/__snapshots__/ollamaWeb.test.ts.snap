exports[`セットアップ手順の golden > setupCommands — 4 ブロックすべて > origin-claude-ai 1`] = `
[
  {
    "command": "# 1. Ollama を入れる — 未導入なら https://ollama.com/download から
#    Ollama.app を入れて一度起動 (ここだけ手作業)
# 2. 軽いモデルを 1 つ入れる (約 1.3 GB)
ollama pull llama3.2:1b
# 3. このページからの読み取りを許可して再起動
launchctl setenv OLLAMA_ORIGINS "https://claude.ai"
killall ollama 2>/dev/null; open -a Ollama
# 4. 確認 — {"version":"..."} が出れば成功
sleep 3 && curl -s http://127.0.0.1:11434/api/version",
    "os": "macOS",
  },
  {
    "command": "# 1. Ollama を入れる (入っていれば何もしません)
command -v ollama >/dev/null || curl -fsSL https://ollama.com/install.sh | sh
# 2. 軽いモデルを 1 つ入れる (約 1.3 GB)
ollama pull llama3.2:1b
# 3. このページからの読み取りを許可して再起動
sudo mkdir -p /etc/systemd/system/ollama.service.d
printf '[Service]\\nEnvironment="OLLAMA_ORIGINS=https://claude.ai"\\n' \\
  | sudo tee /etc/systemd/system/ollama.service.d/origins.conf
sudo systemctl daemon-reload && sudo systemctl restart ollama
# 4. 確認 — {"version":"..."} が出れば成功
sleep 3 && curl -s http://127.0.0.1:11434/api/version",
    "os": "Linux (systemd)",
  },
  {
    "command": "# 1. Ollama を入れる (入っていれば何もしません)
if (-not (Get-Command ollama -EA SilentlyContinue)) { winget install -e --id Ollama.Ollama }
# 2. 軽いモデルを 1 つ入れる (約 1.3 GB)
ollama pull llama3.2:1b
# 3. このページからの読み取りを許可して再起動
[Environment]::SetEnvironmentVariable("OLLAMA_ORIGINS", "https://claude.ai", "User")
Get-Process ollama -EA SilentlyContinue | Stop-Process
Start-Process "$env:LOCALAPPDATA\\Programs\\Ollama\\ollama app.exe"
# 4. 確認 — {"version":"..."} が出れば成功
Start-Sleep 3; curl.exe -s http://127.0.0.1:11434/api/version",
    "os": "Windows (PowerShell)",
  },
  {
    "command": "ollama pull llama3.2:1b
OLLAMA_ORIGINS="https://claude.ai" ollama serve",
    "os": "1 回だけ試す (OS 共通・このターミナルは開いたまま)",
  },
]
`;

