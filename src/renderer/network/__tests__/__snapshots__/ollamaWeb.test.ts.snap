exports[`セットアップ手順の golden > originsSetupSteps — 許可だけを足す手順 > origins-claude-ai 1`] = `
[
  {
    "command": "launchctl setenv OLLAMA_ORIGINS "https://claude.ai" && killall ollama && open -a Ollama",
    "os": "macOS",
  },
  {
    "command": "sudo systemctl edit ollama.service
# [Service] セクションに追記:
Environment="OLLAMA_ORIGINS=https://claude.ai"
sudo systemctl daemon-reload && sudo systemctl restart ollama",
    "os": "Linux (systemd)",
  },
  {
    "command": "[Environment]::SetEnvironmentVariable("OLLAMA_ORIGINS", "https://claude.ai", "User")
# Ollama を終了して再起動",
    "os": "Windows (PowerShell)",
  },
  {
    "command": "OLLAMA_ORIGINS="https://claude.ai" ollama serve",
    "os": "手元で試すだけ",
  },
]
`;

