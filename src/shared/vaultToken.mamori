//! 保存された資格情報から `Authorization` ヘッダへ載せる文字列を取り出す —— アプリ全体で 1 つだけ持つ。
//!
//! ## 保存されている値は 2 種類ある
//!
//! - **生の文字列** —— PAT / API キーを貼り付けたもの (`ghp_…` / `sk-ant-…`)
//! - **TokenSet の JSON** —— OAuth の結果 (`{accessToken, refreshToken, expiresAt, …}`)
//!
//! どちらも同じ 1 本の口 (`vault.getToken` / `secrets.getToken`) から出てくるので、呼び出し側は区別できない。ここが区別する。
//!
//! ## なぜ「壊れた TokenSet」を raw に落としてはいけないか
//!
//! 2026-08-20 の監査で、レンダラ側が **JSON として読めたのに `accessToken` が無い場合、その JSON 丸ごとを Bearer として送っていた**。
//! TokenSet には `refreshToken` が入る。つまりアクセストークンより強い refresh token が、それを渡す必要のない相手
//! (ブラウザ版では利用者のプロキシ = 第三者のホストも経由する) へ出る。しかも JSON の塊は Bearer として通らないので、
//! **認証は必ず失敗する** —— 漏らす代償だけ払って得るものが無い。
//!
//! 主プロセス側 (`secrets.ts` の `getOAuthTokens`) は同じ状況で null を返していたが、Authorization ヘッダに載るのは
//! `getValidToken` の戻り値で、そちらは生の JSON を返していた (パス 246)。両方が断るようにし、文面は
//! `brokenStoredCredentialMessage` 1 つにした。**規則はここだけに置く。**
//!
//! ## 判定
//!
//! | 保存された値 | 返す |
//! |---|---|
//! | JSON として読めない (`ghp_abc`) | その文字列 (生のトークン) |
//! | JSON だがオブジェクトでない (`12345`) | その文字列 (数字だけの API キー) |
//! | オブジェクトで `accessToken` が非空文字列 | その `accessToken` |
//! | オブジェクトだが使える `accessToken` が無い | **null** (壊れた TokenSet) |
//!
//! ## Mamori で書いてある (2026-11-01 · MG-014)
//!
//! 元は TypeScript。足りなかったのは `as` の 4 か所と template 文字列 2 つだけで、`as` は `field` に、template は連結に替えた
//! (型述語 `parsed is {…}` は印の型でなければ通る —— T-248 が断るのは印の型を名乗る述語だけ)。組み上がる文字列は 1 字も変えていない。

use { countChars } from "./inputCeiling";
use { hasControlChars, MAX_TOKEN_INPUT_CHARS } from "./tokenInput";

/// 使える `accessToken` を持つ TokenSet の形。
export type UsableTokenSet = { accessToken: string };

/// TokenSet として使える形か。**規則はここだけ**に置く。
///
/// 配列も `typeof === 'object'` なので通ってしまうが、`accessToken` を持たない以上どのみち false になる。
/// 空文字は「あるが使えない」。Bearer に載せても相手は必ず 401 を返すので、未設定として扱うほうが利用者に正しく伝わる。
export fn hasUsableAccessToken(parsed: unknown) -> parsed is UsableTokenSet {
  if (parsed === null || typeof parsed !== 'object') {
    return false;
  }
  const token = field parsed.accessToken;
  return typeof token === 'string' && token !== '';
}

/// 「保存された資格情報が壊れている」の文面 —— **両ビルドで 1 つ**。
export fn brokenStoredCredentialMessage(serviceId: string) -> string {
  return serviceId + ' の保存された資格情報が壊れています。設定から登録し直してください';
}

/// 保存された値から Bearer 文字列を取り出す。取り出せなければ null。
///
/// null は「登録し直しが要る」を意味する。呼び出し側は**送らずに**そう伝えること。
export fn bearerFromStoredToken(raw: string) -> string | null {
  let parsed: unknown;
  try {
    parsed = JSON.parse(raw);
  } catch {
    // **ここで return しない。** JSON ですらない値は `parsed` が undefined のまま下へ落ち、「オブジェクトでない」の枝と合流する。
  }
  // JSON として読めても、オブジェクトでなければ TokenSet ではない。
  if (parsed === null || typeof parsed !== 'object') {
    return raw;
  }
  return hasUsableAccessToken(parsed) ? parsed.accessToken : null;
}

export type TokenSetRejectReason = 'no-access-token' | 'control-char' | 'too-long' | 'unserializable';

export type TokenSetCheck =
  | { readonly ok: true; readonly serialized: string }
  | { readonly ok: false; readonly reason: TokenSetRejectReason; readonly message: string };

/// **保存する前に TokenSet を見る** (2026-09-14 · パス 259)。
///
/// 制御文字は**包む前に**見る (`JSON.stringify` は制御文字をエスケープ列へ逃がすので、包んだ後では見えない)。
/// 長さは**実際にファイルへ行く文字列 (包んだ後)** で測り、そのまま返す。天井は入口の関門と同じ定数を読む。
export fn checkTokenSetForStorage(tokens: unknown) -> TokenSetCheck {
  if (!hasUsableAccessToken(tokens)) {
    return { ok: false, reason: 'no-access-token', message: '認可サーバの応答に使えるアクセストークンがありません' };
  }
  for (const entry of Object.entries(tokens)) {
    const value = entry[1];
    if (typeof value === 'string' && hasControlChars(value)) {
      return { ok: false, reason: 'control-char', message: '認可サーバの応答の ' + entry[0] + ' に改行・制御文字が含まれています' };
    }
  }
  let serialized: string;
  try {
    serialized = JSON.stringify(tokens);
  } catch {
    // 循環参照 / BigInt。関門が投げてはいけない。
    return { ok: false, reason: 'unserializable', message: '認可サーバの応答を保存できる形にできません' };
  }
  const chars = countChars(serialized);
  if (chars > MAX_TOKEN_INPUT_CHARS) {
    return { ok: false, reason: 'too-long', message: '認可サーバの応答が長すぎます (' + chars + ' 文字 / 上限 ' + MAX_TOKEN_INPUT_CHARS + ' 文字)' };
  }
  return { ok: true, serialized };
}
