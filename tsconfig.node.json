{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src/main",
    "src/preload",
    "vite.config.ts",
    "vitest.config.ts",
    "scripts/generate-dashboard.ts",
    "electron-builder.json"
  ]
}
