# 設定の名前の一覧。値は書かない (書いてあるのは、秘密でない既定値だけ)。
# 使うときは .env へ写して値を入れる。.env は追跡しない (.gitignore)。

# 必須
PUBLIC_BASE_URL=
AUDIT_LOG_PATH=

# 第 5 層: トークン (寿命は 300 秒が天井)
TOKEN_TTL_SECONDS=300
SIGNING_KEY_ROTATE_HOURS=24

# 第 3 層: 物理キーとスマホのパスキー (WebAuthn)
# RP_ID / RP_ORIGIN は、空なら PUBLIC_BASE_URL から決める。
# 物理キーは、機種の一覧 (ALLOWED_AAGUIDS) と発行元の証明書 (ATTESTATION_ROOTS_FILE = 公開の PEM) の
# 両方を置くまで 1 本も登録できない。
RP_ID=
RP_ORIGIN=
ALLOWED_AAGUIDS=
ATTESTATION_ROOTS_FILE=
CREDENTIALS_FILE=
ENROLLMENT_FILE=

# 第 4 層: ふるまいの点数のしきい値
RISK_STEP_UP=0.6
RISK_FREEZE=0.85

# 第 6 層: おとりの控え (ハッシュだけ)・発行を止める印・遮断
CANARY_HASHES_FILE=
ISSUANCE_HALT_FILE=
ADMIN_ALLOWLIST=
BLOCK_TIMEOUT_HOURS=24
BLOCK_RATE_LIMIT_PER_MIN=20

# 遮断を実際に動かすのは true と書いたときだけ (既定は dry-run)
FIREWALL_EXECUTE=false

# 第 2 層: 端末の健康の証明 (off / report / enforce)。
# 守りのソフト (EDR・端末管理) の管理サービスが端末ごとに署名して出す「健康の証明」を、トークンを出す前に検める。
# まず report (記録だけ) で、どの端末が足りていないかを見てから enforce にする。
ATTESTATION_MODE=off
# 信頼する発行元の公開鍵 (JSON: {"issuers":[{"iss":"https://…","keys":[公開鍵の JWK + kid]}]})。秘密鍵は置かない。
DEVICE_HEALTH_ISSUERS_FILE=
# 感染を報せた利用者・端末の控え (再起動しても隔離を外さない)。
QUARANTINE_FILE=
# 定義ファイル (時間) と OS の更新 (日) が、これより古ければ「健康でない」。
HEALTH_MAX_SIGNATURE_AGE_HOURS=72
HEALTH_MAX_PATCH_AGE_DAYS=45
