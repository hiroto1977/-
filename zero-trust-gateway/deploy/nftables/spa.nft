# 入口の骨組み (ARCHITECTURE_V2.md §3.1)。まだ本番で試していない —— 試験用のサーバーで先に試す。
#
# 読み込む前に: ① admin / admin6 に自分の管理用 IP を入れる (締め出されない道)
#               ② KNOCK_PORT を決める  ③ 手元の画面 (コンソール) で入れる状態にしておく
# 確かめるだけなら: nft --check --file spa.nft

define KNOCK_PORT = 62201

table inet spa {
  set allowed   { type ipv4_addr; flags timeout; }
  set allowed6  { type ipv6_addr; flags timeout; }
  set blocked   { type ipv4_addr; flags timeout; }
  set blocked6  { type ipv6_addr; flags timeout; }
  set admin     { type ipv4_addr; }
  set admin6    { type ipv6_addr; }

  chain input {
    type filter hook input priority 0; policy drop;

    iif lo accept
    ct state established,related accept

    # 締め出されない道: 管理用の IP からの SSH は、遮断の一覧より先に通す
    ip  saddr @admin  tcp dport 22 accept
    ip6 saddr @admin6 tcp dport 22 accept

    ip  saddr @blocked  drop
    ip6 saddr @blocked6 drop

    # ノックは受けるが、返信はしない
    udp dport $KNOCK_PORT accept

    ip  saddr @allowed  tcp dport 443 accept
    ip6 saddr @allowed6 tcp dport 443 accept
  }
}
